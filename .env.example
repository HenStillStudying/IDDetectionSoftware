# Copy this file to .env and fill in real values — .env is gitignored,
# never commit it. Used by docker-compose.yml.

# Required. Redis transiently holds raw uploaded KTP photo bytes as async
# job data (see README's "Data handling & compliance"), so this can't be
# left unset the way it can for a quick non-Docker local check.
REDIS_PASSWORD=your-own-password-here

# Optional. Unset disables API-key auth entirely — fine for a first local
# compose run, not for anything reachable beyond localhost.
KTP_API_KEY=

# Optional. Shared secret between the api/worker containers and the ocr
# container's own auth check (services/ocr/ocr_app/main.py). Unset means
# the ocr service accepts any caller on this compose network — fine since
# nothing publishes its port to the host, but worth setting once this
# moves beyond a single trusted compose network.
KTP_OCR_INTERNAL_KEY=
